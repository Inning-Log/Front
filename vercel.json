{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://54.116.214.217/api/:path*"
    },
    {
      "source": "/v3/api-docs",
      "destination": "http://54.116.214.217/v3/api-docs"
    },
    {
      "source": "/v3/api-docs/:path*",
      "destination": "http://54.116.214.217/v3/api-docs/:path*"
    },
    {
      "source": "/swagger-ui/:path*",
      "destination": "http://54.116.214.217/swagger-ui/:path*"
    },
    {
      "source": "/swagger-ui.html",
      "destination": "http://54.116.214.217/swagger-ui.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],

  "headers": [
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}